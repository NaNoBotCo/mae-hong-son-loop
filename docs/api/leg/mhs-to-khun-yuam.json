 "names": {
  "name": "Mae Hong Son to Khun Yuam",
  "th": "แม่ฮ่องสอน – ขุนยวม",
  "said": "Over the mountains and onto the long road south.",
  "said_th": "ข้ามเขาแล้วออกสู่ถนนสายยาวลงใต้"
 },
