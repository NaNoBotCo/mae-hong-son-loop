  "rows": [
   {
    "en": "(man speaking)",
    "th": "ครับ",
    "rtgs": "khrap",
    "say": "khráp"
   },
   {
    "en": "(woman speaking)",
    "th": "ค่ะ",
    "rtgs": "kha",
    "say": "khâ"
   }
  ]
 },
